public class HitungHari {
 
    private int tahun;
    private int bulan;
 
    public HitungHari(int tahun, int bulan) {
        this.tahun = tahun;
        this.bulan = bulan;
    }
 
    public int hitung() {
        // Cek tahun kabisat untuk bulan Februari
        switch (bulan) {
            case 1:  // Januari
            case 3:  // Maret
            case 5:  // Mei
            case 7:  // Juli
            case 8:  // Agustus
            case 10: // Oktober
            case 12: // Desember
                return 31;
 
            case 4:  // April
            case 6:  // Juni
            case 9:  // September
            case 11: // November
                return 30;
 
            case 2:  // Februari
                if ((tahun % 400 == 0) || (tahun % 4 == 0 && tahun % 100 != 0)) {
                    return 29; // Tahun kabisat
                } else {
                    return 28;
                }
 
            default:
                return -1; // Bulan tidak valid
        }
    }
}
